# Copy to .env and fill in real values before running `docker compose up`.
# Never commit a real .env file - it is gitignored.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=forge
POSTGRES_USER=forge
POSTGRES_PASSWORD=change-me-in-every-non-local-environment

# --- Backend / JWT -------------------------------------------------------------
# HS256 signing secret for access tokens. Generate a strong one, e.g.:
#   openssl rand -base64 48
# Minimum 256 bits. Rotating this invalidates every outstanding access token
# (refresh tokens are unaffected - they are opaque and stored in Redis, not signed).
FORGE_JWT_SECRET=change-me-generate-a-real-256-bit-secret

FORGE_ACCESS_TOKEN_TTL_MINUTES=15
FORGE_REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ------------------------------------------------------------------
# Comma-separated list of EXACT origins allowed to call the API. Not patterns, and never "*":
# the API sends credentialed CORS responses, which browsers reject if the origin is a wildcard.
FORGE_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Registration --------------------------------------------------------------
# Public POST /v1/auth/register. Off by default: knowing a tenant's slug must not be enough to
# create an account inside it. Add users via POST /v1/users (permission USER_INVITE) instead.
# Only turn this on for a deliberately open deployment (free tier, demo environment).
FORGE_SELF_SERVICE_REGISTRATION=false

# --- Frontend ----------------------------------------------------------------
VITE_API_PROXY_TARGET=http://localhost:8080

# --- Email (FRD-10) ------------------------------------------------------------
# false (default) logs messages instead of sending them - nothing is silently dropped, it is
# logged at WARN. Set true and configure spring.mail.* for real delivery via any SMTP relay.
FORGE_MAIL_ENABLED=false
FORGE_MAIL_FROM=no-reply@localhost

# --- Billing (FRD-9) -----------------------------------------------------------
FORGE_BILLING_PROVIDER=manual
# HMAC-SHA256 shared secret for POST /v1/webhooks/billing. BLANK MEANS WEBHOOKS ARE REFUSED (503),
# never accepted unverified - that endpoint can change any tenant's plan.
FORGE_BILLING_WEBHOOK_SECRET=
# true lets a tenant change their own plan without a payment provider (dev / invoice-billed).
# Set false wherever a card is involved: the provider, not this API, decides what was paid for.
FORGE_BILLING_SELF_SERVE=true

# --- API keys (FRD-12) ---------------------------------------------------------
# Pepper for API-key hashes. Separate from FORGE_JWT_SECRET on purpose: rotating this invalidates
# every customer integration, rotating the JWT secret does not.
#   openssl rand -base64 48
FORGE_API_KEY_HASHING_KEY=change-me-generate-a-real-secret
# Per-key requests/minute on /v1/public/**. 0 disables.
FORGE_API_KEY_RATE_LIMIT=120

# --- SSO (FRD-13) --------------------------------------------------------------
# Externally reachable origin of this API. Must match the redirect URI registered at each IdP; it
# cannot be derived from the request (a proxy reports the internal host, and Host is client-supplied).
FORGE_SSO_BASE_URL=http://localhost:8080
# Encrypts IdP client secrets at rest (AES-GCM).
#   openssl rand -base64 48
FORGE_SSO_ENCRYPTION_KEY=change-me-generate-a-real-secret
FORGE_SSO_LOGIN_STATE_TTL=300

# --- Scheduled maintenance -----------------------------------------------------
# Monthly reset of the metered instance counter (00:05 UTC on the 1st) and the expired-SSO-state
# sweep. Both run under a Redis lock, so it is safe to leave these identical across replicas.
FORGE_USAGE_RESET_CRON=0 5 0 1 * *
FORGE_SSO_SWEEP_MS=3600000
FORGE_SSO_SWEEP_INITIAL_MS=60000

# --- Host port mapping ---------------------------------------------------------
# Only the HOST side of each published port. Container ports and the internal service
# names are fixed, so the SPA still reaches the API at http://backend:8080 regardless.
# Change these when something else on your machine already owns the default.
FORGE_BACKEND_PORT=8080
FORGE_FRONTEND_PORT=5173
FORGE_POSTGRES_PORT=5432
FORGE_REDIS_PORT=6379
