# The Dockerfile runs `npm ci` inside the image, so a host node_modules is both unnecessary and
# harmful: it is the largest thing in the repo (hundreds of MB shipped to the daemon on every
# build) and may contain platform-specific native binaries built for the host, not the image.
node_modules
dist
.vite
*.tsbuildinfo

# Emitted by `tsc -b` if the outDir redirection in tsconfig.node.json is ever removed.
vite.config.js
vite.config.d.ts

.env
.env.local
npm-debug.log*
